DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wandor
JWT_SECRET=change_this_to_something_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Twilio (SMS fallback + can also do WhatsApp via Twilio if you don't want to deal with Meta's onboarding)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API (Meta) - primary channel, cheaper at scale than Twilio's WA markup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
